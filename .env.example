# CYCLOAN Environment Variables Example
# Copy this to .env and update with your actual values
# IMPORTANT: Never commit .env file to version control!

# ========== EMAIL CONFIGURATION ==========
# Gmail: Use app-specific password (not your regular password)
# See: https://support.google.com/accounts/answer/185833
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_FROM_NAME=CYCLOAN Support
MAIL_PORT=587
MAIL_ENCRYPTION=tls

# ========== OTP SETTINGS ==========
# How long OTP codes are valid (in minutes)
OTP_EXPIRATION_MINUTES=10

# Maximum verification attempts before lockout
OTP_MAX_ATTEMPTS=5

# Length of OTP code
OTP_LENGTH=6

# ========== RATE LIMITING CONFIGURATION ==========
# Enable/disable rate limiting globally
RATE_LIMIT_ENABLED=true

# Registration: Maximum registrations per IP address
RATE_LIMIT_REGISTRATION_PER_IP=5

# Registration: Time window in seconds (1 hour = 3600 seconds)
RATE_LIMIT_REGISTRATION_WINDOW=3600

# OTP: Maximum OTP requests per email address
RATE_LIMIT_OTP_PER_EMAIL=3

# OTP: Time window in seconds for OTP requests
RATE_LIMIT_OTP_WINDOW=3600

# Verification: Maximum OTP verification attempts per email
RATE_LIMIT_VERIFICATION_PER_EMAIL=5

# Verification: Time window in seconds (5 minutes = 300 seconds)
RATE_LIMIT_VERIFICATION_WINDOW=300

# ========== TWO-FACTOR AUTHENTICATION SETTINGS ==========
# Enable/disable 2FA globally
TWO_FACTOR_ENABLED=true

# 2FA method: 'email', 'sms', or 'totp'
TWO_FACTOR_METHOD=email

# Grace period for 2FA in seconds (5 minutes = 300 seconds)
TWO_FACTOR_GRACE_PERIOD=300

# ========== DATABASE CONFIGURATION ==========
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=cycloan
DB_PORT=3306

# ========== APPLICATION CONFIGURATION ==========
APP_NAME=CYCLOAN
APP_URL=http://localhost:8000
APP_ENV=development

# Set to false in production
APP_DEBUG=false

# ========== SESSION CONFIGURATION ==========
# Session lifetime in seconds (30 minutes = 1800 seconds)
SESSION_LIFETIME=1800

# Set to true in production (requires HTTPS)
SESSION_SECURE=false

# Prevent JavaScript access to session cookie
SESSION_HTTP_ONLY=true

# ========== REDIS CONFIGURATION ==========
# Enable Redis for distributed rate limiting and session storage
# Requires Redis to be installed and running
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========== PRODUCTION SETTINGS ==========
# Uncomment these settings when deploying to production:

# APP_ENV=production
# APP_DEBUG=false
# SESSION_SECURE=true
# RATE_LIMIT_ENABLED=true
# TWO_FACTOR_ENABLED=true
# REDIS_ENABLED=true
